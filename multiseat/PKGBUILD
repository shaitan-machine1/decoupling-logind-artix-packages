pkgname=multiseat
pkgver=0.1.0
pkgrel=6
pkgdesc='Seat topology orchestrator supervising one seatd process per seat'
arch=(x86_64)
url='https://github.com/shaitan-machine1/multiseat'
license=(GPL-3.0-only)
depends=(dbus gcc-libs glibc libudev s6 seat-udev seatd)
makedepends=(cargo git rust)
_commit=74c00deff2e296be2d9d2f897f536b1559981175
source=("git+ssh://git@github.com/shaitan-machine1/multiseat.git#commit=$_commit")
sha256sums=('SKIP')

build() {
  cd "$srcdir/multiseat"
  CARGO_TARGET_DIR=target cargo build --release --locked --workspace
}

check() {
  cd "$srcdir/multiseat"
  CARGO_TARGET_DIR=target cargo test --release --locked --workspace
}

package() {
  cd "$srcdir/multiseat"
  install -Dm755 target/release/multiseatd "$pkgdir/usr/bin/multiseatd"
  install -Dm755 target/release/multiseatctl "$pkgdir/usr/bin/multiseatctl"
  install -Dm755 target/release/seat-launch "$pkgdir/usr/bin/seat-launch"
  install -Dm644 dist/dbus/org.decoupling.multiseatd1.conf \
    "$pkgdir/usr/share/dbus-1/system.d/org.decoupling.multiseatd1.conf"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
