pkgname=sddm
pkgver=0.21.0
pkgrel=16
pkgdesc='QML Wayland display manager with explicit seat backends'
arch=(x86_64)
url='https://github.com/shaitan-machine1/sddm'
license=(GPL-2.0-or-later)
provides=(display-manager)
depends=(bash dbus glibc libgcc libstdc++ libxau libxcb pam pam_rundir qt6-base
         qt6-declarative ttf-font weston xorg-xauth)
makedepends=(cmake git ninja qt6-tools)
optdepends=('elogind: provide the logind seat backend'
            'multiseat: provide the multiseatd backend'
            'sway: packaged example user session')
backup=('etc/pam.d/sddm' 'etc/pam.d/sddm-autologin' 'etc/pam.d/sddm-greeter')
_commit=b2a713d1a5241dd8d2234bee72b500f3421b6aa9
source=("git+https://github.com/shaitan-machine1/sddm.git#commit=$_commit"
        sddm.sysusers
        sddm.tmpfiles)
sha256sums=('SKIP' 'SKIP' 'SKIP')

build() {
  cmake -S sddm -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBEXECDIR=/usr/lib/sddm \
    -DBUILD_WITH_QT6=ON \
    -DBUILD_MAN_PAGES=OFF \
    -DDBUS_CONFIG_DIR=/usr/share/dbus-1/system.d \
    -DDBUS_CONFIG_FILENAME=sddm_org.freedesktop.DisplayManager.conf \
    -DENABLE_JOURNALD=OFF \
    -DNO_SYSTEMD=ON \
    -DUID_MAX=60513 \
    -DSDDM_INITIAL_VT=7
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  # PAM and account policy belong to the distribution package, not the fork.
  install -Dm644 "$startdir/sddm.pam" "$pkgdir/etc/pam.d/sddm"
  install -Dm644 "$startdir/sddm-autologin.pam" "$pkgdir/etc/pam.d/sddm-autologin"
  install -Dm644 "$startdir/sddm-greeter.pam" "$pkgdir/etc/pam.d/sddm-greeter"
  install -Dm644 "$srcdir/sddm.sysusers" "$pkgdir/usr/lib/sysusers.d/sddm.conf"
  install -Dm644 "$srcdir/sddm.tmpfiles" "$pkgdir/usr/lib/tmpfiles.d/sddm.conf"
}
