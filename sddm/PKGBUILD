pkgname=sddm
pkgver=0.21.0
pkgrel=9
pkgdesc='QML Wayland display manager with multiseatd integration'
arch=(x86_64)
url='https://github.com/shaitan-machine1/sddm'
license=(GPL-2.0-or-later)
provides=(display-manager)
depends=(bash glibc libgcc libstdc++ libxau libxcb pam qt6-base qt6-declarative seatd ttf-font weston xorg-xauth)
makedepends=(cmake git ninja qt6-tools)
optdepends=('sway: packaged example user session')
backup=('etc/pam.d/sddm' 'etc/pam.d/sddm-greeter' 'etc/sddm.conf.d/10-decoupling.conf')
_commit=73edeef4320212c2507365a4af3c46f49de789b4
source=("git+ssh://git@github.com/shaitan-machine1/sddm.git#commit=$_commit"
        sddm.sysusers
        sddm.tmpfiles)
sha256sums=('SKIP'
            '9fce66f325d170c61caed57816f4bc72e9591df083e89da114a3bb16b0a0e60f'
            'db625f2a3649d6d203e1e1b187a054d5c6263cadf7edd824774d8ace52219677')

build() {
  cmake -S sddm -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBEXECDIR=/usr/lib/sddm \
    -DBUILD_WITH_QT6=ON \
    -DBUILD_MAN_PAGES=OFF \
    -DDBUS_CONFIG_DIR=/usr/share/dbus-1/system.d \
    -DDBUS_CONFIG_FILENAME=sddm_org.freedesktop.DisplayManager.conf \
    -DENABLE_JOURNALD=OFF \
    -DNO_SYSTEMD=ON \
    -DUID_MAX=60513
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  cd "$srcdir/sddm"
  install -Dm644 dist/sddm.conf.d/10-decoupling.conf \
    "$pkgdir/etc/sddm.conf.d/10-decoupling.conf"
  install -Dm644 dist/pam/sddm "$pkgdir/etc/pam.d/sddm"
  install -Dm644 dist/pam/sddm-greeter "$pkgdir/etc/pam.d/sddm-greeter"
  install -Dm644 "$srcdir/sddm.sysusers" "$pkgdir/usr/lib/sysusers.d/sddm.conf"
  install -Dm644 "$srcdir/sddm.tmpfiles" "$pkgdir/usr/lib/tmpfiles.d/sddm.conf"
}
