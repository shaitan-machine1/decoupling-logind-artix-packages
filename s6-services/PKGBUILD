pkgbase=s6-services
pkgname=(sessiond-s6 multiseat-s6 sddm-s6)
pkgver=0.1.0
pkgrel=4
arch=(any)
url='https://github.com/shaitan-machine1/decoupling-logind-artix-packages'
license=(GPL-3.0-only)

_install_services() {
  local service
  install -d "$pkgdir/etc/s6/sv"
  for service in "$@"; do
    cp -a "$startdir/services/$service" "$pkgdir/etc/s6/sv/"
  done
  install -Dm644 "$startdir/../LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

package_sessiond-s6() {
  pkgdesc='s6-rc service definition for sessiond'
  depends=(dbus-s6 s6-base s6-rc sessiond)

  _install_services sessiond-srv sessiond-log
}

package_multiseat-s6() {
  pkgdesc='s6-rc service definition for multiseatd'
  depends=(dbus-s6 multiseat s6-base s6-rc udev)

  _install_services multiseatd-srv multiseatd-log
}

package_sddm-s6() {
  pkgdesc='s6-rc service definition for SDDM with the multiseatd backend'
  depends=(dbus-s6 multiseat-s6 s6-base s6-rc sddm udev)
  provides=(init-sddm)
  conflicts=(init-sddm)
  backup=('etc/sddm.conf.d/10-multiseatd.conf')

  _install_services sddm-srv sddm-log
  install -Dm644 "$startdir/sddm-multiseatd.conf" \
    "$pkgdir/etc/sddm.conf.d/10-multiseatd.conf"
}
