pkgbase = s6-services
	pkgver = 0.1.0
	pkgrel = 4
	url = https://github.com/shaitan-machine1/decoupling-logind-artix-packages
	arch = any
	license = GPL-3.0-only

pkgname = sessiond-s6
	pkgdesc = s6-rc service definition for sessiond
	depends = dbus-s6
	depends = s6-base
	depends = s6-rc
	depends = sessiond

pkgname = multiseat-s6
	pkgdesc = s6-rc service definition for multiseatd
	depends = dbus-s6
	depends = multiseat
	depends = s6-base
	depends = s6-rc
	depends = udev

pkgname = sddm-s6
	pkgdesc = s6-rc service definition for SDDM with the multiseatd backend
	depends = dbus-s6
	depends = multiseat-s6
	depends = s6-base
	depends = s6-rc
	depends = sddm
	depends = udev
	provides = init-sddm
	conflicts = init-sddm
	backup = etc/sddm.conf.d/10-multiseatd.conf
