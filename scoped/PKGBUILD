pkgname=scoped
pkgver=0.1.0
pkgrel=4
pkgdesc='Root-only D-Bus cgroup v2 scope manager'
arch=(x86_64)
url='https://github.com/shaitan-machine1/scoped'
license=(GPL-3.0-only)
depends=(dbus gcc-libs glibc)
makedepends=(cargo git rust)
_commit=8e652d9acb8c1aa67db91405b234a66979ccf1a9
source=("git+ssh://git@github.com/shaitan-machine1/scoped.git#commit=$_commit")
sha256sums=('SKIP')

build() {
  cd "$srcdir/scoped"
  CARGO_TARGET_DIR=target cargo build --release --locked --workspace
}

check() {
  cd "$srcdir/scoped"
  CARGO_TARGET_DIR=target cargo test --release --locked --workspace
}

package() {
  cd "$srcdir/scoped"
  install -Dm755 target/release/scoped "$pkgdir/usr/bin/scoped"
  install -Dm755 target/release/scopectl "$pkgdir/usr/bin/scopectl"
  install -Dm644 dist/dbus/org.decoupling.scoped1.conf \
    "$pkgdir/usr/share/dbus-1/system.d/org.decoupling.scoped1.conf"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
