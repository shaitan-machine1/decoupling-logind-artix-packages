pkgname=seatd
pkgver=0.9.3
pkgrel=2
pkgdesc='Seat management library with inherited multiseatd connection support'
arch=(x86_64)
url='https://github.com/shaitan-machine1/seatd'
license=(MIT)
provides=('libseat.so')
replaces=('libseat')
depends=(glibc)
makedepends=(git meson ninja)
_commit=01797d95fbd20bebb212d3a8810f3071aedf53da
source=("git+ssh://git@github.com/shaitan-machine1/seatd.git#commit=$_commit")
sha256sums=('SKIP')

build() {
  meson setup build seatd \
    --prefix=/usr \
    --buildtype=plain \
    -Dexamples=disabled \
    -Dserver=enabled \
    -Dlibseat-seatd=enabled \
    -Dlibseat-logind=disabled \
    -Dlibseat-builtin=disabled \
    -Dman-pages=disabled
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  DESTDIR="$pkgdir" meson install -C build
  install -Dm644 "$srcdir/seatd/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
