pkgname=decoupling-logind-s6
pkgver=0.1.0
pkgrel=4
pkgdesc='s6-rc service definitions for the decoupled login stack'
arch=(any)
url='https://github.com/shaitan-machine1/decoupling-logind-artix-packages'
license=(GPL-3.0-only)
depends=(dbus-s6 s6-base s6-rc udev)
provides=('elogind=257.16' 'logind=257.16' 'logind-s6' 'init-logind' 'init-sddm')
conflicts=('elogind' 'logind-s6' 'init-logind' 'init-sddm')
replaces=('elogind')
source=()
sha256sums=()

package() {
  install -d "$pkgdir/etc/s6/sv"
  cp -a "$srcdir/../services/." "$pkgdir/etc/s6/sv/"
  install -Dm644 "$startdir/../LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
