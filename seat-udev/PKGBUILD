pkgname=seat-udev
pkgver=0.1.0
pkgrel=2
pkgdesc='Seat device discovery and assignment runtime integration'
arch=(any)
url='https://github.com/shaitan-machine1/seat-udev'
license=(GPL-3.0-only)
depends=(udev)
makedepends=(git)
_commit=00126146f8e1ba1417ed4ec31541a079cff57f47
source=("git+ssh://git@github.com/shaitan-machine1/seat-udev.git#commit=$_commit")
sha256sums=('SKIP')

package() {
  cd "$srcdir/seat-udev"
  install -Dm644 dist/udev/71-seat.rules \
    "$pkgdir/usr/lib/udev/rules.d/71-seat.rules"
  install -Dm644 dist/udev/73-seat-late.rules \
    "$pkgdir/usr/lib/udev/rules.d/73-seat-late.rules"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
